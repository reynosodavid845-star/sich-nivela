flowchart TD
    A(["Submenú 1: Catálogo"]) --> B[/"Mostrar 1.1, 1.2, 1.3<br/>con marcas sin permiso /<br/>pendiente y 0 Regresar"/]
    B --> C[/"Leer opción"/]
    C --> D{"¿Número<br/>de 0 a 3?"}
    D -->|No| E[/"Opción no válida,<br/>intente de nuevo"/]
    E --> C
    D -->|Sí| F{"¿Opción = 0?"}
    F -->|Sí| R(["Regresar al<br/>menú principal"])
    F -->|No| G{"¿El rol tiene<br/>permiso?"}
    G -->|No| H[/"No tiene permisos<br/>para esta opción"/]
    G -->|Sí| K{"¿Opción?"}
    K -->|1| K1[["1.1 Registrar<br/>herramienta<br/>[Pendiente Fase 4]"]]
    K -->|2| K2[["1.2 Asociar<br/>apodos<br/>[Pendiente Fase 4]"]]
    K -->|3| K3[["1.3 Modificar<br/>herramienta<br/>[Pendiente Fase 4]"]]
    K1 --> PE[/"Funcionalidad pendiente<br/>de implementación"/]
    K2 --> PE
    K3 --> PE
    H --> P[/"Presione Enter para<br/>volver al menú"/]
    PE --> P
    P --> B
    classDef pendiente fill:#eeeeee,stroke:#666666,color:#222222
    class K1,K2,K3 pendiente
